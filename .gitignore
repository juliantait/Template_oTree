db.sqlite3
__pycache__/
*.pyc
*.pyo
.DS_Store
.env
.venv/
*.bak
*.log

# Generated instruction previews — regenerable output, never tracked.
/previews/

# Agent working notes: briefs, review dumps, intermediate reasoning. Not
# deliverables, so they stay local rather than shipping to a copied study.
_ai/

# THE DEPLOY BUILD STAMP — written at deploy by scripts/write_build_info.py,
# never committed. A commit cannot contain its own SHA, so a committed stamp
# would describe the PREVIOUS commit in the tree of the next one: a stale
# provenance record, which is worse than none.
#
# TRAP, AND IT HAS BITTEN: `railway up` HONOURS .gitignore, so this very line
# makes the stamp invisible to that deploy and the build ships inert, reporting
# unstamped while looking perfectly healthy. The deploy step must delete
# .gitignore from its throwaway staging tree and write a .railwayignore instead
# — see docs/hosting_railway.md.
BUILD_INFO.json

# EXPORTED PARTICIPANT DATA. `scripts/export_data.py` defaults `--out` to the
# RELATIVE path `exports`, so the documented way to pull data during a run
# writes participant CSVs — answers, timings, Prolific IDs — into the repo root.
# Consented research data does not belong in a git history, or in a build
# context (`.dockerignore` excludes it too).
exports/

# Curl cookie jars, BY PATTERN and not by name. They only ever arrive from
# ad-hoc curl debugging, and one of them (in the study this template feeds) was
# committed holding a LIVE ADMIN SESSION COOKIE. The next one will not be
# called cookies.txt — it may well be admin_cookies.txt, which is why the
# pattern wraps the word rather than anchoring to the start of the name.
*cookie*.txt
*.cookies
*cookiejar*
